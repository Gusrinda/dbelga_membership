<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/mainLayout"
    android:orientation="vertical"
    android:weightSum="1"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UbahPassword">


    <RelativeLayout
        android:elevation="8sp"
        android:background="@drawable/background_grad_biru"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.3">

        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="Ubah Password Akun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:src="@drawable/ic_baseline_lock_24"
            android:layout_centerInParent="true"
            android:layout_width="100dp"
            android:layout_height="100dp" />


    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginVertical="16dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/darkBiruBelga"
            app:hintTextColor="@color/darkBiruBelga">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordLama"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password Lama"
                android:textColor="@color/darkBiruBelga" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout

            android:layout_marginVertical="16dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/darkBiruBelga"
            app:hintTextColor="@color/darkBiruBelga">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordBaru"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password Baru"

                android:textColor="@color/darkBiruBelga" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout

            android:layout_marginVertical="16dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/darkBiruBelga"
            app:hintTextColor="@color/darkBiruBelga">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordBaru2"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan kembali password baru"
                android:textColor="@color/darkBiruBelga" />

        </com.google.android.material.textfield.TextInputLayout>


        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:layout_marginVertical="8sp"
                android:id="@+id/btnSimpanPassword"
                android:textColor="@color/white"
                android:background="@drawable/button_round_theme"
                android:text="SIMPAN PASSWORD"
                android:layout_marginHorizontal="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:layout_marginVertical="8sp"
                android:id="@+id/btnKembali"
                android:textColor="@color/white"
                android:background="@drawable/button_round_cancel"
                android:text="KEMBALI"
                android:layout_marginHorizontal="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


        </LinearLayout>


    </LinearLayout>

</LinearLayout>