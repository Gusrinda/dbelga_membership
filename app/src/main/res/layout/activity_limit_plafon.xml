<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LimitPlafon">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/biruBelga"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:elevation="0dp"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                app:elevation="0dp"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/biruBelga"
                app:title="Limit Member Dbelga"
                tools:ignore="HardcodedText">

            </androidx.appcompat.widget.Toolbar>

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:background="@drawable/background_round_limit"
            android:layout_width="match_parent"
            android:layout_height="146dp">

            <TextView
                android:layout_marginBottom="8dp"
                android:layout_centerInParent="true"
                android:layout_above="@id/txt_LimitPengguna"
                android:text="Limit Anda"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_centerInParent="true"
                android:id="@+id/txt_LimitPengguna"
                android:text="Rp. 1.200.000"
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <TextView
                android:layout_marginBottom="8dp"
                android:layout_centerInParent="true"
                android:layout_alignParentBottom="true"
                android:textStyle="italic"
                android:text="tingkatkan limit anda >"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

        <ScrollView
            android:fillViewport="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <androidx.cardview.widget.CardView
                    android:layout_marginTop="12sp"
                    android:layout_marginHorizontal="16sp"
                    app:contentPadding="16sp"
                    app:cardCornerRadius="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <LinearLayout
                                android:layout_marginLeft="16sp"
                                android:layout_centerVertical="true"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_marginBottom="4dp"
                                    android:text="Sisa Limit"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:textSize="24dp"
                                    android:id="@+id/txt_SisaLimit"
                                    android:text="Rp. 200.000"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>


                            <TextView
                                android:id="@+id/txt_persentasePenggunaan"
                                android:layout_marginRight="16sp"
                                android:textSize="36dp"
                                android:layout_centerVertical="true"
                                android:layout_alignParentRight="true"
                                android:text="85%"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                        </RelativeLayout>




                        <ProgressBar
                            android:layout_marginHorizontal="16sp"
                            android:layout_marginTop="4dp"
                            android:progress="85"
                            android:id="@+id/progress_horizontal"

                            android:layout_alignParentBottom="true"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />


                    </LinearLayout>


                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    app:contentPadding="16sp"
                    app:cardCornerRadius="8dp"
                    android:layout_marginVertical="12sp"
                    android:layout_marginHorizontal="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/btn_TagihanBulanIni"
                            android:layout_marginVertical="4dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:layout_marginVertical="4dp"
                                        android:text="Tagihan Limit Bulan Ini"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:textStyle="bold"
                                        android:textSize="18sp"
                                        android:id="@+id/txt_tagihanBulanIni"
                                        android:text="Rp. 200.000"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:id="@+id/txt_keteranganTagihan"
                                        android:textSize="12sp"
                                        android:layout_marginVertical="4dp"
                                        android:text="keterangan tagihan !"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                </LinearLayout>

                                <ImageView
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitXY"
                                    android:layout_alignParentRight="true"
                                    android:src="@drawable/ic_baseline_navigate_next_24"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"/>

                            </RelativeLayout>

                            <View
                                android:layout_marginVertical="4dp"
                                android:background="@color/biruBelga"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"/>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_DaftarTagihan"
                            android:layout_marginVertical="4dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <ImageView
                                        android:src="@drawable/ic_baseline_list_alt_24"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        app:tint="@color/biruBelga" />

                                    <TextView
                                        android:layout_marginLeft="8dp"
                                        android:layout_marginVertical="4dp"
                                        android:text="Tagihan Saya"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>



                                </LinearLayout>

                                <ImageView
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitXY"
                                    android:layout_alignParentRight="true"
                                    android:src="@drawable/ic_baseline_navigate_next_24"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"/>

                            </RelativeLayout>

                            <View
                                android:layout_marginVertical="4dp"
                                android:background="@color/biruBelga"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"/>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_RiwayatLimit"
                            android:layout_marginVertical="4dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <ImageView
                                        android:src="@drawable/ic_baseline_history_24"
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        app:tint="@color/biruBelga" />

                                    <TextView
                                        android:layout_marginLeft="8dp"
                                        android:layout_marginVertical="4dp"
                                        android:text="Riwayat Limit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>



                                </LinearLayout>

                                <ImageView
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitXY"
                                    android:layout_alignParentRight="true"
                                    android:src="@drawable/ic_baseline_navigate_next_24"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"/>

                            </RelativeLayout>

                            <View
                                android:layout_marginVertical="4dp"
                                android:background="@color/biruBelga"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"/>


                        </LinearLayout>



                    </LinearLayout>






                </androidx.cardview.widget.CardView>

            </LinearLayout>



        </ScrollView>


    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>