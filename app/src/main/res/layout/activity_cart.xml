<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Screen.Katalog.CartActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/biruBelga"
                app:popupTheme="@style/AppTheme.PopupOverlay"
                app:title="Keranjang Anda"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/img_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16sp"
                android:src="@drawable/ic_baseline_remove_shopping_cart_24" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginVertical="4dp"
            android:layout_above="@id/layoutOngkir"
            tools:listitem="@layout/item_cart"
            android:id="@+id/rv_itemCart"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <LinearLayout
            android:id="@+id/layoutOngkir"
            android:layout_above="@id/layoutTotalBelanja"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <View
                android:background="#C1C1C1"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_weight="5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:textSize="12sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Total Ongkir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txt_Ongkir"
                        android:textSize="16sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Rp. 10.000"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>


                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_weight="5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"

                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <TextView
                            android:textSize="12sp"
                            android:fontFamily="@font/hammer_font"
                            android:textColor="@color/black"
                            android:text="Total Jarak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txt_Jarak"
                            android:textSize="16sp"
                            android:fontFamily="@font/hammer_font"
                            android:textColor="@color/black"
                            android:text="+- 5 Km"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />


                    </LinearLayout>

                    <RelativeLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent">

                        <Button
                            android:id="@+id/btnAlamatPengiriman"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="@android:color/transparent"
                            android:drawableTop="@drawable/ic_baseline_pin_drop_24"
                            android:drawableTint="@android:color/holo_orange_dark"
                            android:text="Alamat\nPengiriman"
                            android:textAllCaps="false"
                            android:textColor="@android:color/holo_orange_dark"
                            android:textSize="10dp" />


                    </RelativeLayout>

                </LinearLayout>



            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTotalBelanja"
            android:layout_above="@id/layoutMetodePembayaran"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <View
                android:background="#C1C1C1"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_weight="5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:textSize="12sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Total Belanja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txt_totalBelanja"
                        android:textSize="16sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Rp. 10.000"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>


                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_weight="5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:textSize="12sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Total Qty Item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txt_totalQty"
                        android:textSize="16sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="5"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMetodePembayaran"
            android:layout_above="@id/layoutBottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:background="#C1C1C1"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <LinearLayout
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_weight="75"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Metode Pembayaran"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtMetode"
                        android:textSize="16sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="metode belum dipilih"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_metodePembayaran"
                    android:gravity="center"
                    android:background="@color/material_orange_400"
                    android:orientation="vertical"
                    android:layout_weight="25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <ImageView
                        android:src="@drawable/bg_payment"
                        android:layout_width="24dp"
                        android:layout_height="24dp" />

                    <TextView
                        android:text="Pembayaran"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBottom"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:background="#C1C1C1"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <LinearLayout
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_weight="75"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <TextView
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="SubTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txtGrandTotal"
                        android:textSize="20sp"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/black"
                        android:text="Rp. 800.000 ( x item )"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_Checkout"
                    android:gravity="center"
                    android:background="@color/greyBelha"
                    android:orientation="vertical"
                    android:layout_weight="25"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <ImageView
                        android:src="@drawable/ic_baseline_shopping_cart_24"
                        android:layout_width="24dp"
                        android:layout_height="24dp" />

                    <TextView
                        android:text="Checkout"
                        android:fontFamily="@font/hammer_font"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>