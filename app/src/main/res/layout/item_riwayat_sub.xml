<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView android:layout_marginVertical="2dp"
    app:contentPadding="8dp"
    app:cardCornerRadius="20dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:weightSum="2"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_NomorOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NFD12201180001"
                android:textColor="@color/black" />

            <TextView
                android:layout_marginTop="4dp"
                android:textAlignment="viewEnd"
                android:textSize="12sp"
                android:id="@+id/txt_totalOrder"
                android:text="Rp. 1.700.000 ( Lunas )"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/material_green_900"/>

            <TextView
                android:layout_marginTop="4dp"
                android:textAlignment="viewEnd"
                android:textSize="10sp"
                android:id="@+id/txt_totalDenda"
                android:text="+ Rp. 2.500 (Denda)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/material_red_500"/>

            <TextView
                android:layout_marginTop="4dp"
                android:id="@+id/txt_tanggalOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="26-04-2021" />

            <LinearLayout
                android:id="@+id/layoutJatuhTempo"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="Jatuh Tempo : " />

                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"
                    android:id="@+id/txtJatuhTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="26-04-2021" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_weight="0.1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <androidx.cardview.widget.CardView
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            android:id="@+id/cardLunasi"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="72dp">


            <RelativeLayout
                android:id="@+id/relativeCardPelunasan"
                android:padding="8dp"
                android:background="@color/merahBelga"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_marginTop="8dp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/iconLunasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_baseline_check_24"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/txtJudulLunasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iconLunasi"
                    android:layout_centerInParent="true"
                    android:text="Lunasi ?"
                    android:textColor="@color/white"
                    android:textSize="10sp" />


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <View
            android:layout_weight="0.1"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <androidx.cardview.widget.CardView
            app:cardCornerRadius="10dp"
            android:id="@+id/cardInformasi"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="72dp">


            <RelativeLayout
                android:padding="8dp"
                android:background="@color/material_orange_800"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_marginTop="8dp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/iconInformasi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/information"
                    app:tint="@color/white" />

                <TextView
                    android:textAlignment="center"
                    android:id="@+id/txtJudulInformasi"
                    android:layout_width="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iconInformasi"
                    android:layout_centerInParent="true"
                    android:text="Info\nTransaksi" />


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>