<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#DFFFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Screen.User.Verifikasi.CameraGuideline">

    <RelativeLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessLeaf">


        <TextView
            android:id="@+id/textPetunjuk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/hammer"
            android:gravity="center"
            android:textColor="@color/biruBelga"
            android:textSize="16dp"
            android:textStyle="bold" />


        <FrameLayout
            android:layout_above="@id/layoutBawah"
            android:layout_marginVertical="86dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/frame_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                android:id="@+id/inc_layout_foto_identitas"
                android:visibility="invisible"
                layout="@layout/foto_identitas_layout"/>

            <include
                android:id="@+id/inc_layout_foto_wajah"
                android:visibility="invisible"
                android:layout_width="match_parent"
                layout="@layout/foto_wajah_layout"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/inc_layout_foto_selfie"
                android:visibility="invisible"
                layout="@layout/foto_selfie_layout"/>

        </FrameLayout>

        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp"
            android:id="@+id/layoutBawah"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="86dp"
           >

            <Button
                android:id="@+id/btn_ambil_foto"
                android:text="Ambil Foto"
                android:background="@drawable/button_round_theme"
                android:drawableTop="@drawable/ic_baseline_camera"
                android:textColor="@color/white"
                android:drawableTint="@color/white"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginHorizontal="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>