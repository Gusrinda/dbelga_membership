<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CameraGuideline">

    <RelativeLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessLeaf">


        <FrameLayout

            android:layout_above="@id/layoutBawah"
            android:layout_marginVertical="86dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/frame_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <include
                android:id="@+id/inc_layout_foto_identitas"
                android:visibility="invisible"
                layout="@layout/foto_identitas_layout"/>

            <include
                android:id="@+id/inc_layout_foto_wajah"
                android:visibility="invisible"
                android:layout_width="match_parent"
                layout="@layout/foto_wajah_layout"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/inc_layout_foto_selfie"
                android:visibility="invisible"
                layout="@layout/foto_selfie_layout"/>

        </FrameLayout>

        <RelativeLayout
            android:layout_marginBottom="32dp"
            android:id="@+id/layoutBawah"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="86dp"
           >

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_centerInParent="true"
                android:id="@+id/btn_ambil_foto"
                android:backgroundTint="@color/colorPrimary"
                android:src="@drawable/ic_photo_camera_black_48dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="ContentDescription" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>