<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingTop="8dp">

    <View
        android:layout_marginTop="@dimen/material_layout_vertical_spacing_between_content_areas"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="#7F606060"/>

    <LinearLayout
        android:layout_marginVertical="@dimen/activity_vertical_margin"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Urutkan"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <TextView
        android:text="Berdasarkan"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinnerUrut"
        android:entries="@array/stringUrutkan"
        android:layout_marginVertical="@dimen/material_layout_vertical_spacing_between_content_areas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



    <Button
        android:id="@+id/btnFilterData"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12sp"
        android:layout_width="match_parent"
        android:text="Urutkan Data"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@color/hijauBelga"
        android:layout_height="wrap_content"/>

</LinearLayout>