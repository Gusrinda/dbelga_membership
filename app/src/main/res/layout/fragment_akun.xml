<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:paddingHorizontal="16dp"
    android:paddingVertical="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Screen.NewMainScreen.Fragment.AkunFragment">

    <LinearLayout
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:layout_above="@id/btnKeluar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMember"
            android:layout_width="wrap_content"
            android:layout_height="172dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">

            <RelativeLayout
                android:background="@drawable/card_reguler"
                android:padding="16dp"
                android:id="@+id/layoutCardMember"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_marginTop="40dp"
                    android:id="@+id/headerCard"
                    android:weightSum="3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="NAMA MEMBER"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtNamaMember"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text=""
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <LinearLayout
                        android:visibility="gone"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:src="@drawable/dbelga" />

                        <LinearLayout
                            android:id="@+id/bintangPremium"
                            android:visibility="visible"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bintangGold"
                            android:visibility="gone"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/headerCard"
                    android:id="@+id/bodyCard"
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="NOMOR MEMBERSHIP"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtNomorMember"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="-"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutExpired"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="EXP DATE"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtExpDate"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="-"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_below="@id/layoutAAA"
            android:layout_above="@id/btb_upgrade"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:fillViewport="true"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_marginVertical="8sp"
                android:layout_width="match_parent"
                android:layout_height="0dp">

                <LinearLayout
                    android:id="@+id/layoutBBB"
                    android:layout_marginVertical="8sp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">



                    <LinearLayout
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textColor="@color/darkBiruBelga"
                            android:textSize="18sp"
                            android:text="MEMBERSHIP"
                            android:fontFamily="@font/hammer"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:layout_marginEnd="4dp"
                            android:id="@+id/btnMembershipPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/button_round_theme"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/hammer_font"
                                android:gravity="center"
                                android:textSize="10sp"
                                android:text="Membership Plan"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="@color/white" />

                            <ImageView
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_appintro_arrow"
                                android:layout_width="12dp"
                                android:layout_height="12dp"/>


                        </LinearLayout>

                    </LinearLayout>



                    <androidx.cardview.widget.CardView
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:visibility="gone"
                                android:id="@+id/plafonDebet"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_marginHorizontal="4dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:textAlignment="center"
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textAlignment="center"
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Limit Plafon"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:id="@+id/text_creditLimit"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="Rp. 0"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                                <LinearLayout
                                    android:layout_marginHorizontal="4dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textAlignment="center"
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Sisa Plafon"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textAlignment="center"
                                        android:id="@+id/text_sisaLimit"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="Rp. 0"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btnPiutangBelanja"
                                    android:layout_marginHorizontal="4dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textAlignment="center"
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Piutang Belanja"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                    <TextView
                                        android:textAlignment="center"
                                        android:id="@+id/text_piutangBelanja"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="Rp. 0"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:visibility="visible"
                                android:id="@+id/plafonReguler"
                                android:gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">


                                <LinearLayout
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textAlignment="center"
                                        android:textColor="#7F302E2E"
                                        android:textStyle="bold|italic"
                                        android:text="Dapatkan keuntungan plafon dan saldo piutang belanja dengan bergabung menjadi member 'DEBET' Dbelga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_horizontal" />


                                </LinearLayout>


                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_below="@id/layoutBBB"
                    android:id="@+id/layoutCCC"
                    android:layout_marginVertical="8sp"
                    android:layout_marginHorizontal="18dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <TextView
                        android:layout_marginBottom="8sp"
                        android:textColor="@color/darkBiruBelga"
                        android:text="DANA"
                        android:textSize="18sp"
                        android:fontFamily="@font/hammer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.cardview.widget.CardView
                        app:contentPadding="16dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">


                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="Rp. 100.000"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="saldo belga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="Rp. 10.000"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="poin belga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>


                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <LinearLayout
                    android:layout_below="@id/layoutCCC"
                    android:id="@+id/layoutDDD"
                    android:layout_marginVertical="8sp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_marginBottom="8sp"
                        android:textColor="@color/darkBiruBelga"
                        android:textSize="18sp"
                        android:text="TRANSAKSI &amp; POIN"
                        android:fontFamily="@font/hammer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />


                    <androidx.cardview.widget.CardView
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">


                                <LinearLayout
                                    android:visibility="gone"
                                    android:id="@+id/view_TotalTransaksi"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Total Transaksi"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                    <TextView
                                        android:id="@+id/txt_TotalTransaksi"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="6 Transaksi"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                                <LinearLayout
                                    android:visibility="visible"
                                    android:id="@+id/view_TotalPoinBelanja"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Total Poin Belanja"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                    <TextView
                                        android:id="@+id/txt_TotalPoin"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="- Poin"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/view_DetailTransaksi"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_money"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textAlignment="center"
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Detail Transaksi"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_horizontal" />


                                    <TextView
                                        android:gravity="center"
                                        android:textSize="10sp"
                                        android:textStyle="italic"
                                        android:text="klik disini untuk melihat data transaksi anda"
                                        android:textColor="@color/darkBiruBelga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />


                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEEE"
                    android:layout_below="@id/layoutDDD"
                    android:layout_marginVertical="8sp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/darkBiruBelga"
                        android:textSize="18sp"
                        android:fontFamily="@font/hammer_font"
                        android:text="VOUCHER"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.cardview.widget.CardView
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">


                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:id="@+id/ln_voucherMember"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_voucher_a"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:id="@+id/text_jumlahVoucherMember"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="-"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Voucher Anda"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ln_voucherKlaim"
                                    android:layout_marginHorizontal="16dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:src="@drawable/ic_baseline_voucher"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:id="@+id/text_jumlahVoucherKlaim"
                                        android:textColor="@color/darkBiruBelga"
                                        android:text="-"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#7F302E2E"
                                        android:text="Voucher Yang Dapat Diklaim"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />

                                </LinearLayout>

                            </LinearLayout>


                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </RelativeLayout>


        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnKeluar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_round_theme"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/logout"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/hammer_font"
            android:gravity="center"
            android:text="Keluar"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/white" />


    </LinearLayout>


</RelativeLayout>