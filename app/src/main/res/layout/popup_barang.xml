<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/popup_round"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/produk_kategori"
        android:layout_centerHorizontal="true"
        android:text="KATEGORI"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/produk_close"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_baseline_close_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/produk_image"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:layout_centerHorizontal="true"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/not_found" />

    <TextView
        android:layout_below="@id/produk_image"
        android:id="@+id/produk_name"
        android:layout_marginLeft="16sp"
        android:text="Nama Produk"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_marginTop="4dp"
        android:layout_below="@id/produk_name"
        android:id="@+id/produk_deskripsi"
        android:layout_marginLeft="16sp"
        android:text="Lorem Ipsum hahahahahaha hihihihihihi huhuhuhuhuhuhu heheheheheeh hohohohohohohooho"
        android:maxLines="3"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@id/produk_deskripsi"
        android:orientation="horizontal"
        android:id="@+id/layout_harga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/produk_price1"
            android:layout_marginLeft="16sp"
            android:text="Rp. 80.000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:visibility="gone"
            android:textColor="@color/colorRose"
            android:id="@+id/produk_price2"
            android:layout_marginLeft="4dp"
            android:text="Rp. 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:visibility="gone"
            android:textColor="@color/colorRose"
            android:id="@+id/keterangan_diskon"
            android:layout_marginLeft="4dp"
            android:text="( Disc. 10)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />


    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:layout_marginVertical="4dp"
        android:gravity="center_vertical"
        android:layout_below="@id/layout_harga"
        android:id="@+id/layoutDiskonMembership"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

            <TextView
                android:layout_marginLeft="16sp"
                android:text="DISKON MEMBERSHIP : "
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/keterangan_diskon_membership"
                android:layout_marginLeft="4dp"
                android:text="0 Produk"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:layout_below="@id/layoutDiskonMembership"
        android:id="@+id/layoutStok"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout_Stok"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_marginTop="4dp"
                android:layout_marginLeft="16sp"
                android:text="Stok Produk :"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="4dp"
                android:id="@+id/produk_stok"
                android:layout_marginLeft="4dp"
                android:text="0 Produk"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:layout_marginLeft="4dp"
            android:id="@+id/layout_Stok_Promo"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_marginTop="4dp"
                android:id="@+id/stokPromo"
                android:layout_marginLeft="4dp"
                android:text="[ 0 Promo ]"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="16dp"
        android:layout_below="@id/layoutStok"
        android:paddingVertical="12sp"
        android:gravity="center"
        android:id="@+id/layout_pesanStok"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/order_btnMinQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/prangeBelha"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/order_qtyOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:backgroundTint="@color/colorPrimaryDark"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:hint="0"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:text="" />

        <Button
            android:id="@+id/order_btnPlusQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/prangeBelha"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="16dp"
        android:layout_below="@id/layout_pesanStok"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_marginEnd="4dp"
                android:id="@+id/layout_button"
                android:paddingVertical="12sp"
                android:gravity="center"
                android:background="@drawable/button_round_voucher"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_like"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>

                <TextView
                    android:textColor="@color/white"
                    android:layout_marginLeft="4dp"
                    android:textStyle="bold"
                    android:text="+ Wishlist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout

                android:layout_marginStart="4dp"
                android:id="@+id/layout_button_Keranjang"
                android:paddingVertical="12sp"
                android:gravity="center"
                android:background="@drawable/button_round_theme"

                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_baseline_shopping_cart_24"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>

                <TextView
                    android:textColor="@color/white"
                    android:layout_marginLeft="4dp"
                    android:textStyle="bold"
                    android:text="+ Keranjang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:visibility="gone"
            android:textColor="@color/merahBelga"
            android:textSize="12sp"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:id="@+id/peringatanText"
            android:text="Barang sudah ada dalam keranjang !"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>


</RelativeLayout>