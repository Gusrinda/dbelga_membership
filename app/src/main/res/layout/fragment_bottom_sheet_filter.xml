<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingTop="8dp">

    <View
        android:layout_marginTop="@dimen/material_layout_vertical_spacing_between_content_areas"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="#7F606060"/>

    <LinearLayout
        android:layout_marginVertical="@dimen/activity_vertical_margin"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Filter"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/btnResetFilter"
            android:textStyle="bold"
            android:textColor="@color/darkBiruBelga"
            android:text="reset filter"
            android:textAlignment="viewEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <TextView
        android:text="Kategori"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKategori"
        android:layout_marginVertical="@dimen/material_layout_vertical_spacing_between_content_areas"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        android:orientation="horizontal"
        app:reverseLayout="false"
        tools:listitem="@layout/item_kategori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:paddingVertical="@dimen/material_layout_vertical_spacing_between_content_areas"
        android:text="Harga"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:weightSum="2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="wrap_content"
            app:hintTextColor="@color/darkBiruBelga">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hargaRendah"
                android:textSize="14sp"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Terendah"
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:textAlignment="center"
            android:text="-"
            android:textSize="20sp"
            android:fontFamily="@font/hammer"
            android:textColor="@color/black"
            android:layout_weight="0.4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="wrap_content"
            app:hintTextColor="@color/darkBiruBelga">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hargaTinggi"
                android:textSize="14sp"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tertinggi"
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFilterData"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12sp"
        android:layout_width="match_parent"
        android:text="Filter Data"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="@color/hijauBelga"
        android:layout_height="wrap_content"/>

</LinearLayout>