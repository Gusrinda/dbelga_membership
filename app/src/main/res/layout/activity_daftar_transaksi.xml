<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DaftarTransaksi">

    <RelativeLayout
        android:elevation="8sp"
        android:gravity="center_vertical"
        android:background="@color/biruBelga"
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/judulAppbar"
            android:layout_marginLeft="32dp"
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:text="Transaksi Saya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutSearch"
        android:padding="8sp"
        android:layout_below="@id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="4dp"
            android:background="@drawable/search_round"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_baseline_search_24"
                android:layout_width="20dp"
                android:layout_height="20dp" />

            <EditText
                android:layout_marginHorizontal="8sp"
                android:id="@+id/edt_cariTransaksi"
                android:textSize="12sp"
                android:hint="Cari transaksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/spinner"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_below="@id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_marginHorizontal="8sp"
            android:background="@drawable/spinner_round"
            android:weightSum="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <Spinner
                android:padding="6dp"
                android:entries="@array/tanggal_transaksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <LinearLayout
            android:layout_marginHorizontal="8sp"
            android:background="@drawable/spinner_round"
            android:weightSum="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <Spinner
                android:padding="6dp"
                android:entries="@array/status_transaksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_Transaksi"
        tools:listitem="@layout/adapter_list_transaksi"
        android:layout_marginTop="8sp"
        android:layout_below="@id/spinner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>