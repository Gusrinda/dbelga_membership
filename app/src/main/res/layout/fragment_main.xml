<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp"
    tools:context=".Screen.NewMainScreen.Fragment.MainFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:background="@color/Transparent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapseToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="?attr/colorPrimary"
            style="@style/AppTheme"
            app:layout_scrollFlags="scroll|snap|exitUntilCollapsed">

            <androidx.cardview.widget.CardView
                app:layout_collapseMode="parallax"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                app:cardCornerRadius="8dp">

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iss_auto_cycle="true"
                    app:iss_delay="0"
                    app:iss_period="1000" />

            </androidx.cardview.widget.CardView>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layoutMain"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginVertical="4dp"
                android:id="@+id/rv_menu_pilihan"
                tools:listitem="@layout/item_pilihan_menu"
                tools:itemCount="3"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <RadioGroup
                android:visibility="gone"
                android:layout_marginVertical="4dp"
                android:checkedButton="@+id/radio_Terlaris"
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/pick_out_line"
                android:orientation="horizontal">

                <RadioButton
                    android:paddingVertical="4dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginLeft="1dp"
                    android:id="@+id/radio_Terlaris"
                    android:background="@drawable/toogle_widget_background"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Terlaris"
                    android:textColor="@color/white" />

                <RadioButton
                    android:paddingVertical="4dp"
                    android:layout_marginRight="1dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:id="@+id/radio_Katalog"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/toogle_widget_background"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Katalog"
                    android:textColor="@color/white" />

            </RadioGroup>

            <LinearLayout
                android:visibility="visible"
                android:id="@+id/linearKatalog"
                android:orientation="vertical"
                android:weightSum="1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_marginTop="4dp"
                    android:weightSum="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_marginBottom="5dp"
                        android:layout_weight="0.8"
                        android:background="@drawable/bg_cari"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <EditText
                            android:id="@+id/cariBarang"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="0.7"
                            android:background="@drawable/bg_cari"
                            android:hint="Cari barang . . "
                            android:maxLines="1"
                            android:minLines="1"
                            android:padding="2dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <ImageView
                            android:id="@+id/imageBtn"
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="2dp"
                            android:layout_weight="0.1"
                            android:src="@drawable/ic_search_black_24dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutFilter"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="0.1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:src="@drawable/ic_baseline_filter_list_24"
                            android:layout_width="16dp"
                            android:layout_height="16dp" />

                        <TextView
                            android:textSize="8sp"
                            android:textColor="#939393"
                            android:text="filter"
                            android:layout_width="wrap_content"
                            android:layout_height="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSort"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="0.1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:src="@drawable/ic_baseline_sort_by_alpha_24"
                            android:layout_width="16dp"
                            android:layout_height="16dp" />

                        <TextView
                            android:textSize="8sp"
                            android:textColor="#939393"
                            android:text="urutkan"
                            android:layout_width="wrap_content"
                            android:layout_height="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/labelResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="21dp"
                    android:layout_marginRight="21dp"
                    android:gravity="center_horizontal"
                    android:text="Tidak ada hasil"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelTunggu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center_horizontal"
                    android:text="Harap tunggu..."
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutContentFilter"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:weightSum="1"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/btnDeleteFilter"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_weight="0.25"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:src="@drawable/ic_baseline_delete_24"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:textColor="#7C4747"
                            android:textSize="8sp"
                            android:text="hapus filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:layout_marginTop="4dp"
                    android:id="@+id/swipeBarangOrder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gridview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:spanCount="2"
                            tools:itemCount="10"
                            tools:listitem="@layout/item_barang" />

                        <RelativeLayout
                            android:id="@+id/rv_barang_kosong"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lot_empty"
                                android:layout_centerHorizontal="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/empty_box" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/lot_empty"
                                android:fontFamily="@font/hammer"
                                android:text="Data produk kosong"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textStyle="bold" />

                        </RelativeLayout>

                    </RelativeLayout>

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/linearTerlaris"
                android:orientation="vertical"
                android:weightSum="1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:layout_marginTop="4dp"
                    android:id="@+id/swipeBarangOrderTerlaris"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">


                        <androidx.recyclerview.widget.RecyclerView
                            android:visibility="gone"
                            android:id="@+id/gridViewTerlaris"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:spanCount="2"
                            tools:itemCount="10"
                            tools:listitem="@layout/item_barang" />

                        <RelativeLayout
                            android:id="@+id/rv_terlaris_kosong"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lottie_terlaris_empty"
                                android:layout_centerHorizontal="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/empty_box" />

                            <TextView
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:text="Data produk terlaris kosong"
                                android:layout_below="@id/lottie_terlaris_empty"
                                android:fontFamily="@font/hammer"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </RelativeLayout>

                    </RelativeLayout>




                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/linearPromo"
                android:orientation="vertical"
                android:weightSum="1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:layout_marginTop="4dp"
                    android:id="@+id/swipeBarangPromo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPromo"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="12dp"
                            android:orientation="vertical"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_card_promo" />

                        <RelativeLayout
                            android:id="@+id/rv_promo_kosong"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/lottie_empty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/empty_box" />

                            <TextView
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:text="Tidak ada promo"
                                android:layout_below="@id/lottie_empty"
                                android:fontFamily="@font/hammer"
                                android:textAlignment="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </RelativeLayout>

                    </RelativeLayout>


                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

