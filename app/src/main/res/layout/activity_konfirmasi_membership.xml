    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bagianCount">

        <LinearLayout
            android:id="@+id/layout_hubungiKonfirmasi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_UploadFoto"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Akun anda sedang diproses oleh admin kami !"
                android:textAlignment="center"
                android:textSize="24dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="anda dapat menghubungi admin whatsapp kami apabila ada pertanyaan"
                android:textAlignment="center"
                android:textColor="@color/merahBelga"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ImageView
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:src="@drawable/whatsapp" />

            <TextView
                android:id="@+id/text_NomorWA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="+6281559584297"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="a/n dBelga Mart Tulungagung"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_infoBayar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_UploadFoto"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Segera lakukan pembayaran sebesar"
                android:textAlignment="center"
                android:textColor="@color/merahBelga"
                android:textStyle="italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Rp. 50.000"
                android:textAlignment="center"
                android:textSize="24dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="pada rekening berikut !"
                android:textAlignment="center"
                android:textColor="@color/merahBelga"
                android:textStyle="italic" />

            <ImageView
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:src="@drawable/bca" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="6551 5125 5632 9212"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="a/n dBelga Mart Tulungagung"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_kodeReferral"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_UploadFoto"
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Masukkan kode referral Member"
                android:textAlignment="center"
                android:textColor="@color/merahBelga"
                android:textStyle="italic" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/kodeRefMember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8sp"
                app:hintTextColor="@color/darkBiruBelga">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txt_kodeRefMember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:hint="Masukkan kode referral disini"
                    android:inputType="text"
                    android:textColor="@color/darkBiruBelga"
                    android:textSize="16dp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text="dengan kode referral anda tidak perlu melakukan biaya transfer dan bebas untuk mengunggah foto bukti bayar"
                android:textAlignment="center"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="italic" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutGambarBukti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_UploadFoto"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Bukti Pembayaran"
                android:textAlignment="center"
                android:textColor="@color/merahBelga"
                android:textStyle="italic" />

            <ImageView
                android:id="@+id/fotoBukti"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:src="@mipmap/ic_launcher" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layout_UploadFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_Konfirmasi"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">


                <Button
                    android:id="@+id/btn_showUpload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8sp"
                    android:layout_weight="0.5"
                    android:background="@drawable/button_round_theme"
                    android:padding="8sp"
                    android:text="Pakai Transfer"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_KodeRef"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8sp"
                    android:layout_weight="0.5"
                    android:background="@drawable/button_round_upload"
                    android:padding="8sp"
                    android:text="Pakai Kode Referral"
                    android:textColor="@color/black"
                    android:textSize="10sp" />

            </LinearLayout>


            <Button
                android:id="@+id/btn_UploadFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8sp"
                android:background="@drawable/button_round_voucher"
                android:padding="8sp"
                android:text="Upload Foto Bukti Pembayaran"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="visible" />


        </LinearLayout>

        <Button
            android:id="@+id/btn_Konfirmasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_Batal"
            android:layout_marginHorizontal="48dp"
            android:layout_marginBottom="8sp"
            android:background="@drawable/button_round_confirm"
            android:text="KONFIRMASI PEMBAYARAN"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/btn_Hubungi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_Batal"
            android:layout_marginHorizontal="48dp"
            android:layout_marginBottom="8sp"
            android:background="@drawable/button_round_confirm"
            android:text="HUBUNGI DBELGA"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_Batal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="48dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/button_round_cancel"
            android:text="BATALKAN PENGAJUAN"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </RelativeLayout>

</RelativeLayout>