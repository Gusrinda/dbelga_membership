<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Screen.User.Verifikasi.SetAlamatRumah">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/popup_round"
        android:elevation="5dp"
        android:iconifiedByDefault="false"
        android:queryHint="Search . . ." />

    <androidx.cardview.widget.CardView
        android:id="@+id/getPosisiSekarang"
        map:cardCornerRadius="8dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/cardAlamat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:padding="8dp"
            android:src="@drawable/ic_baseline_pin_drop_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            map:tint="@color/colorPrimary" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAlamat"
        map:cardBackgroundColor="@android:color/white"
        android:layout_margin="16dp"
        map:contentPadding="8dp"
        map:cardCornerRadius="12sp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textColor="@color/black"
                android:text="Alamat : "
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/hammer_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_marginVertical="8sp"
                android:id="@+id/alamatPengiriman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextColor="@color/darkBiruBelga"
                app:hintEnabled="false"
                app:counterMaxLength="255"
                app:counterEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:textSize="12sp"
                    android:id="@+id/txt_alamatPengiriman"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minLines="4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Alamat Pengiriman"
                    android:textColor="@color/darkBiruBelga" />

            </com.google.android.material.textfield.TextInputLayout>


            <LinearLayout

                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout

                    android:layout_marginStart="4dp"
                    android:id="@+id/button_Save"
                    android:paddingVertical="12sp"
                    android:gravity="center"
                    android:background="@drawable/button_round_theme"

                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="5"
                    android:layout_height="wrap_content">


                    <TextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="4dp"
                        android:textStyle="bold"
                        android:text="Simpan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

</RelativeLayout>