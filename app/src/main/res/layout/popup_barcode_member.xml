<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/popup_round"
    android:layout_width="match_parent"
    app:cardElevation="0dp"
    android:elevation="0dp"
    app:cardBackgroundColor="@color/Transparent"
    android:layout_height="wrap_content"
    app:contentPadding="16dp"
    app:cardCornerRadius="32dp"
    android:layout_marginHorizontal="32dp"
    android:layout_gravity="center">

    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="CUSTOMER BARCODE"
            android:textStyle="bold"
            android:fontFamily="@font/hammer_font"
            android:textSize="16dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:adjustViewBounds="true"
                android:id="@+id/output_Barcode"
                android:layout_width="match_parent"
                android:layout_height="120dp"/>

            <TextView
                android:id="@+id/txt_Barcode"
                android:layout_marginVertical="8dp"
                android:text="KODE BARCODE"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>




        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_marginEnd="4dp"
                android:id="@+id/button_Close"
                android:paddingVertical="12sp"
                android:gravity="center"
                android:background="@drawable/button_round_voucher"
                android:backgroundTint="@color/black"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content">

                <TextView
                    android:textColor="@color/white"
                    android:layout_marginLeft="4dp"
                    android:textStyle="bold"
                    android:text="Tutup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout

                android:layout_marginStart="4dp"
                android:id="@+id/button_copy"
                android:paddingVertical="12sp"
                android:gravity="center"
                android:background="@drawable/button_round_theme"

                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="wrap_content">


                <TextView
                    android:textColor="@color/white"
                    android:layout_marginLeft="4dp"
                    android:textStyle="bold"
                    android:text="Copy Kode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</androidx.cardview.widget.CardView>