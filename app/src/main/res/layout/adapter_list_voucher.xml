<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10sp"
    app:contentPadding="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/layoutMain"
        android:padding="4dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <RelativeLayout
            android:background="@drawable/background_grad_biru"
            android:layout_width="86dp"
            android:layout_height="match_parent">


        </RelativeLayout>


        <View
            android:id="@+id/viewGarisTotal"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:background="#6E6E6E" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:weightSum="2"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">


                    <TextView
                        android:id="@+id/namaVoucher"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="NAMA VOUCHER"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tanggalVoucher"
                        android:text="Expired : 10-10-2010"
                        android:textStyle="italic"
                        android:textSize="8sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>

                <LinearLayout
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">

                    <Button
                        android:textColor="@color/white"
                        android:padding="4dp"
                        android:background="@drawable/button_round_theme"
                        android:id="@+id/typeVoucher"
                        android:textSize="10sp"
                        android:text="TIPE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/detailVoucher"
                android:text="Detail voucher adalah ini, nama voucher adalah sesuai dengan nama voucer"
                android:layout_marginTop="12sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <Button
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:text="KLAIM VOUCHER"
                    android:background="@drawable/button_round_voucher"
                    android:id="@+id/btn_AmbilVoucher"
                    android:layout_marginHorizontal="8sp"
                    android:layout_marginVertical="8sp"
                    android:layout_width="match_parent"
                    android:layout_height="36dp" />


            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>