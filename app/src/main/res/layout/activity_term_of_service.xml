<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Screen.Registrasi.TermOfService">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/biruBelga"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            app:title="Term of Service"
            tools:ignore="HardcodedText">

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:padding="16dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:fillViewport="true"
            android:layout_above="@id/linear_bottom"
            android:layout_width="match_parent"
            android:layout_marginBottom="12dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtAgreement"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </ScrollView>

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:id="@+id/linear_bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <Button
                android:id="@+id/btnRejectTOS"
                android:background="@drawable/button_round_theme"
                android:backgroundTint="@color/red_btn_bg_color"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Tolak"
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnApproveTOS"
                android:background="@drawable/button_round_theme"
                android:backgroundTint="#4CAF50"
                android:text="Setuju"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </RelativeLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>