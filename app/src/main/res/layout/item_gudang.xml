<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        app:cardElevation="0dp"
        app:cardCornerRadius="16dp"
        app:contentPadding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:padding="8sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints">

            <RelativeLayout
                android:layout_centerHorizontal="true"
                android:id="@+id/bg"
                android:background="@drawable/round_circle"
                android:layout_width="86dp"
                android:layout_height="86dp">


                <ImageView
                    android:layout_centerInParent="true"
                    android:layout_marginTop="24dp"
                    android:id="@+id/imageSnack"
                    android:src="@drawable/cart"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />


            </RelativeLayout>

            <TextView
                android:fontFamily="@font/hammer_font"
                android:textColor="@color/darkBiruBelga"
                android:layout_marginTop="8sp"
                android:layout_centerHorizontal="true"
                android:id="@+id/namaGudang"
                android:layout_below="@id/bg"
                android:textSize="16dp"
                android:textStyle="bold"
                android:text="Nama Gudang"
                android:layout_width="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_height="wrap_content"/>

            <TextView
                android:fontFamily="@font/hammer_font"
                android:layout_marginTop="8sp"
                android:text="l. KHR Abdul Fattah No.110, Botoran, Kec. Tulungagung, Kabupaten Tulungagung, Jawa Timur 66213"
                android:textAlignment="center"
                android:layout_below="@id/namaGudang"
                android:id="@+id/alamatGudang"
                android:textSize="12sp"
                android:layout_marginBottom="12sp"
                android:minLines="3"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <TextView
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:id="@+id/txt_Jarak"
                android:textSize="12sp"
                android:fontFamily="@font/hammer_font"
                android:textColor="@color/merahBelga"
                android:text="± 5 Km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>