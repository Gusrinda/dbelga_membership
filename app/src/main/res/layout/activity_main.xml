        <androidx.cardview.widget.CardView
            android:id="@+id/cardMember"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="128dp"
            android:layout_width="wrap_content"
            android:layout_height="172dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">

            <RelativeLayout
                android:background="@drawable/card_reguler"
                android:padding="16dp"
                android:id="@+id/layoutCardMember"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_marginTop="40dp"
                    android:id="@+id/headerCard"
                    android:weightSum="3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="NAMA MEMBER"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtNamaMember"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="NAMA MEMBER ADALAH"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <LinearLayout
                        android:visibility="gone"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:src="@drawable/dbelga" />

                        <LinearLayout
                            android:id="@+id/bintangPremium"
                            android:visibility="visible"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bintangGold"
                            android:visibility="gone"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                            <ImageView
                                android:layout_marginHorizontal="4dp"
                                android:src="@drawable/star"
                                android:layout_width="15dp"
                                android:layout_height="15dp" />

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/headerCard"
                    android:id="@+id/bodyCard"
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="NOMOR MEMBERSHIP"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtNomorMember"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="1111"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutExpired"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:textSize="8sp"
                            android:text="EXP DATE"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtExpDate"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:text="11/2021"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>


            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_marginHorizontal="32dp"
            android:layout_marginVertical="8dp"
            android:layout_below="@id/cardMember"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:id="@+id/akunSaya"
                        android:padding="8dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView

                            app:cardCornerRadius="12sp"
                            android:layout_width="match_parent"
                            android:layout_height="128dp">

                            <LinearLayout
                                android:background="@color/colorPrimary"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <ImageView
                                    android:src="@drawable/user"
                                    android:layout_marginBottom="12dp"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:tint="@color/white" />

                                <TextView
                                    android:textColor="@color/white"
                                    android:textStyle="bold"
                                    android:textAlignment="center"
                                    android:text="AKUN SAYA"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_horizontal" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/belanjaMember"
                        android:padding="8dp"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            app:cardCornerRadius="12sp"
                            android:layout_width="match_parent"
                            android:layout_height="128dp">

                            <LinearLayout
                                android:background="@color/colorPrimary"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <ImageView
                                    android:src="@drawable/ic_baseline_shopping_bag_24"
                                    android:layout_marginBottom="12dp"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:tint="@color/white" />

                                <TextView
                                    android:textColor="@color/white"
                                    android:textStyle="bold"
                                    android:textAlignment="center"
                                    android:text="KATALOG PRODUK"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_horizontal" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>


                </LinearLayout>

                <LinearLayout
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:id="@+id/transaksiSaya"
                        android:padding="8dp"
                        android:layout_weight="2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            app:cardCornerRadius="12sp"
                            android:layout_width="match_parent"
                            android:layout_height="128dp">

                            <LinearLayout
                                android:background="@color/colorPrimary"
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center">

                                <ImageView
                                    android:src="@drawable/transaction"
                                    android:layout_marginBottom="12dp"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:tint="@color/white" />

                                <TextView
                                    android:textColor="@color/white"
                                    android:textStyle="bold"
                                    android:textAlignment="center"
                                    android:text="TRANSAKSI SAYA"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_horizontal" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>

                </LinearLayout>


                <TextView
                    android:fontFamily="@font/hammer"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:layout_marginVertical="16dp"
                    android:text="Promo dBelga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <androidx.cardview.widget.CardView
                    app:cardCornerRadius="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="142dp">

                    <com.denzcoskun.imageslider.ImageSlider
                        android:id="@+id/image_slider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:iss_auto_cycle="true"
                        app:iss_period="1000"
                        app:iss_delay="0" />


                </androidx.cardview.widget.CardView>

            </LinearLayout>


        </ScrollView>


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>