<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/mainLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Screen.Promo.KatalogPromo"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/biruBelga"
                app:popupTheme="@style/AppTheme.PopupOverlay"
                app:title="Katalog Promo"
                tools:ignore="HardcodedText">

            </androidx.appcompat.widget.Toolbar>

            <ru.nikartm.support.ImageBadgeView
                android:id="@+id/icon_Keranjang"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16sp"
                android:src="@drawable/ic_baseline_shopping_cart_24"
                app:ibv_badgeColor="#F44336"
                app:ibv_badgeLimitValue="false"
                app:ibv_badgeTextColor="#ffffff"
                app:ibv_badgeTextSize="10sp"
                app:ibv_badgeTextStyle="bold"
                app:ibv_fixedBadgeRadius="10dp"
                app:ibv_maxBadgeValue="99" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:orientation="vertical"
        android:background="#E3E3E3"
        android:weightSum="1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/gambarBanner"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitXY"
            android:src="@drawable/promo_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="19dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_cari"
                android:orientation="horizontal"
                android:padding="5dp">

                <EditText
                    android:id="@+id/cariBarang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/bg_cari"
                    android:hint="Cari barang . . "
                    android:maxLines="1"
                    android:minLines="1"
                    android:padding="2dp"
                    android:singleLine="true"
                    android:textSize="14dp" />

                <ImageView
                    android:padding="2dp"
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_search_black_24dp" />

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/layoutFilter"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_baseline_filter_list_24"
                    android:layout_width="16dp"
                    android:layout_height="16dp" />

                <TextView
                    android:textSize="8sp"
                    android:textColor="#939393"
                    android:text="filter"
                    android:layout_width="wrap_content"
                    android:layout_height="12sp" />

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/layoutSort"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:src="@drawable/ic_baseline_sort_by_alpha_24"
                    android:layout_width="16dp"
                    android:layout_height="16dp" />

                <TextView
                    android:textSize="8sp"
                    android:textColor="#939393"
                    android:text="urutkan"
                    android:layout_width="wrap_content"
                    android:layout_height="12sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/labelResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21dp"
            android:layout_marginRight="21dp"
            android:gravity="center_horizontal"
            android:text="Tidak ada hasil"
            android:visibility="gone" />

        <TextView
            android:id="@+id/labelTunggu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:gravity="center_horizontal"
            android:text="Harap tunggu..."
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutContentFilter"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:weightSum="1"
            android:orientation="horizontal"
            android:layout_marginHorizontal="21dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/btnDeleteFilter"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="0.25"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_baseline_delete_24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:textColor="#7C4747"
                    android:textSize="8sp"
                    android:text="hapus filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:layout_marginTop="4dp"
            android:id="@+id/swipeBarangOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="21dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="10"
                tools:listitem="@layout/item_barang" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</LinearLayout>